# ================================
# Backend (.env) de exemplo
# Renomeie este arquivo para .env e
# preencha com os valores reais
# ================================

# ---- Banco de Dados ----
# O dialeto é escolhido pelo prefixo da DATABASE_URL:
#   postgres://...  -> PostgreSQL (recomendado para produção; SSL é ativado sozinho)
#   mysql://...     -> MySQL
#   (vazio)         -> SQLite local, em backend/database.sqlite
#
# PostgreSQL gratuito (Neon / Supabase): cole aqui a connection string do painel.
#   Ex.: postgres://usuario:senha@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# ATENÇÃO: com DATABASE_URL definida, o servidor NÃO cai para SQLite se a conexão
# falhar — ele encerra com erro, para não subir vazio e perder dados depois.
DATABASE_URL=

# Alternativa legada (MySQL). Só é usada se DATABASE_URL estiver vazia.
MYSQL_URL=
DB_SSL=false

# Caminho do arquivo SQLite. Em container, aponte para um volume persistente.
# SQLITE_PATH=/data/database.sqlite

# Servidor
NODE_ENV=development
PORT=5000

# Autenticação
JWT_SECRET=sua_chave_secreta_super_segura
JWT_EXPIRES_IN=7d

# CORS / Frontend autorizado
FRONTEND_URL=https://seu-frontend.vercel.app

# Rate limiting (opcional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100